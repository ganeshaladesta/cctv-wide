# ==============================================================================
# SCC - EAGLE EYES: Environment Configuration Template
# Sistem Monitoring CCTV dan Unjuk Rasa Nasional
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Optional for cloud sync; SQLite fallback built-in)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# 2. Microsoft Graph OneDrive Integration (Workbook: NEW UNRAS 2022-2026)
# If credentials are not provided, system operates using offline sample fixtures.
# ------------------------------------------------------------------------------
MS_GRAPH_TENANT_ID=your-azure-ad-tenant-id
MS_GRAPH_CLIENT_ID=your-azure-ad-app-client-id
MS_GRAPH_CLIENT_SECRET=your-azure-ad-client-secret
MS_GRAPH_DRIVE_ID=your-onedrive-or-sharepoint-drive-id
MS_GRAPH_ITEM_ID=your-excel-workbook-item-id
MS_GRAPH_WORKSHEET_NAME=NEW UNRAS 2022-2026

# ------------------------------------------------------------------------------
# 3. Scheduled Cron Security (05:00 WIB daily sync)
# ------------------------------------------------------------------------------
CRON_SECRET=your-long-random-cron-secret-token

# ------------------------------------------------------------------------------
# 4. CCTV & Spatial Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PROTEST_LAYER_ENABLED=true
NEXT_PUBLIC_DEFAULT_PROTEST_CCTV_RADIUS_METERS=1500
